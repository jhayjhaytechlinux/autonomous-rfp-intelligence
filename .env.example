# Application
APP_NAME=Autonomous RFP Intelligence Engine
APP_ENV=development
DEBUG=true

# AI Provider
AI_PROVIDER=ollama
AI_MODEL=phi3:mini

# Ollama
OLLAMA_HOST=http://127.0.0.1:11434

# Database
DATABASE_URL=sqlite:///./rfp_intelligence.db

# Bid Decision Thresholds
BID_THRESHOLD=80
REVIEW_THRESHOLD=60

# Application Security
SECRET_KEY=change-this-in-development
