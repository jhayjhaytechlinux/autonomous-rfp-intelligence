# Application
APP_NAME=Autonomous RFP Intelligence Engine
APP_ENV=development
DEBUG=true

# AI Provider
# Supported providers: gemini, ollama
AI_PROVIDER=gemini
AI_MODEL=gemini-3.1-flash-lite

# Gemini
# Never commit your real API key.
GEMINI_API_KEY=your_api_key_here

# Ollama fallback
OLLAMA_HOST=http://127.0.0.1:11434

# Database
DATABASE_URL=sqlite:///./rfp_intelligence.db

# Bid Decision Thresholds
BID_THRESHOLD=80
REVIEW_THRESHOLD=60

# Application Security
SECRET_KEY=change-this-in-development
